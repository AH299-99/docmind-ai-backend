# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=5000

# MongoDB (MongoDB Atlas connection string) — REQUIRED
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docmind

# Auth — REQUIRED. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini — REQUIRED for AI features
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated list of allowed frontend origins.
# When unset, cross-origin browser requests are DENIED (fail-safe).
# Native mobile apps are not affected by this setting.
FRONTEND_URL=http://localhost:8081

# Max AI input length in characters (optional, default 20000)
AI_MAX_TEXT_LENGTH=20000
