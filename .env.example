# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=5000

# MongoDB (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docmind

# Auth — use a long random string in production
JWT_SECRET=

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated list of allowed web frontend origins. Empty means deny web CORS.
FRONTEND_URL=http://localhost:8081
